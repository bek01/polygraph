# Your Nansen API key — https://app.nansen.ai (Account → API)
# NEVER commit the real key. On Vercel, set this in Project Settings → Environment Variables.
NANSEN_API_KEY=nsn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: base URL override (defaults to https://api.nansen.ai/api)
# NANSEN_BASE_URL=https://api.nansen.ai/api

# Optional: seconds to cache Nansen responses in-process (default 120)
# POLYGRAPH_CACHE_TTL=120
